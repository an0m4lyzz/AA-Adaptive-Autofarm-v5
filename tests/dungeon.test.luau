local C=require('../src/core')
local D=require('../src/dungeon')(C)
local n=0
local function check(name,f) local ok,err=pcall(f);assert(ok,name..': '..tostring(err));n+=1 end
local function fixture()
    local data={_started=true,_resources={money=100,treasure=2,treasure_gold=1},_items={},
        next={['1']={_d=1,_t={['1']=true}},['2']={_d=1,_t={['3']=true}}},current_shops={}}
    local service={session={profile_data={dungeon_data=data}}}
    local core={TYPES={SHOP=1,SHRINE=7,OPEN_CHEST=6},ITEMS={tome={cost=20}},NUM_ROOMS=20}
    return service,core,data
end
local function setup(options)
    local service,core,data=fixture()
    local cfg={goal='Acquire',maxSeconds=300,dungeonPreset='Safe',dungeonShopCap=0,dungeonOpenChests=false}
    for k,v in options or {} do cfg[k]=v end
    local s={now=0,dungeonAt=0,inMatch=false,owned={},run='lobby',roundToken={},outcome='unknown'}
    local level
    local function refresh() s.dungeon=D.snapshot(service,core,level);s.dungeonAt=s.now;return s.dungeon end
    local function setLevel(v) level=v;refresh() end
    refresh();return D.engine(cfg,C.logger()),s,data,refresh,setLevel,core,cfg
end
local function shop(data,price)
    data.current_shops={{_t=1,data={{id='tome',currentCost=price}}}}
end
check('parser reads copied native schema and unknown prices',function()
    local service,core,data=fixture();shop(data)
    local d=D.snapshot(service,core,{_dungeon={depth=1,choice_str='1',lives=3,finished=false}})
    assert(d.valid and d.started and d.level.active and d.depth==1 and d.choice=='1')
    assert(d.phase.kind=='Shop' and d.phase.offers[1].price==nil and d.phase.offers[1].baseCost==20)
    data._resources.money=1;data.current_shops[1].data[1].id='other';assert(d.money==100 and d.phase.offers[1].id=='tome')
end)
check('parser never invokes getters or sum function',function()
    local service,core=fixture();core.sum_item_values=function() error('must not call') end
    assert(D.snapshot(service,core).valid)
    local fake=setmetatable({},{__index=function() error('getter invoked') end})
    assert(not D.snapshot(fake,core).valid)
end)
check('unknown schema core flags and phase refuse',function()
    local service,core,data=fixture();assert(not D.snapshot(service,{}).valid)
    data.next['1']._t['99']=true;assert(not D.snapshot(service,core).valid)
    data.next['1']._t['99']=nil;data.current_shops={{_t=99,data={}}};assert(not D.snapshot(service,core).valid)
end)
check('unstarted lobby never emits key-consuming action',function()
    local e,s,d,refresh=setup();d._started=false;refresh();assert(not e:arm(s));assert(e:tick(s)==nil)
end)
check('stale and future snapshots cannot arm',function()
    local e,s=setup();s.now=6;assert(not e:arm(s));s.now=0;s.dungeonAt=1;assert(not e:arm(s))
end)
check('external controller and native fences block arm',function()
    for _,key in {'externalControllerActive','transportBlocked','mutationFence'} do local e,s=setup();s[key]=true;assert(not e:arm(s)) end
end)
check('safe and rewards select known room choices',function()
    local e,s=setup();assert(e:arm(s));local a=e:tick(s);assert(a.kind=='dungeon' and a.name=='dungeon_enter_room' and a.args[1]=='1')
    e,s=setup({dungeonPreset='Rewards'});assert(e:arm(s));assert(e:tick(s).args[1]=='2')
end)
check('active unfinished match never enters a room or resolves early shop',function()
    local e,s,d,refresh=setup();s.inMatch=true;shop(d,20);refresh();assert(e:arm(s));assert(e:tick(s)==nil and e.armed and not e.pending)
    s.resultVisible=true;s.outcome='unknown';assert(e:tick(s)==nil and not e.pending)
    s.outcome='Victory';assert(e:tick(s).name=='dungeon_continue_shop')
end)
check('defeat and dungeon death stop',function()
    local e,s=setup();assert(e:arm(s));s.resultVisible=true;s.outcome='Defeat';assert(e:tick(s)==nil and not e.armed)
    local e2,s2,d,refresh=setup();d._dead={};refresh();assert(not e2:arm(s2))
end)
check('enter requires exact native level transition not rpc truth or selected choice',function()
    local e,s,d,refresh,setLevel=setup();assert(e:arm(s));local a=e:tick(s);assert(a.expected.kind=='enter')
    d.selected_next={choice_str='1',lives=3};refresh();s.rpcResult=true;assert(e:tick(s)==nil and e.pending and e.confirmations==0)
    setLevel({_dungeon={depth=9,choice_str='1',lives=3}});assert(e:tick(s)==nil and e.pending)
    setLevel({_dungeon={depth=1,choice_str='1',lives=3}});s.inMatch=true;assert(e:tick(s)==nil and not e.pending and e.confirmations==1)
    assert(e:tick(s)==nil and not e.pending)
end)
check('enter timeout never retries',function()
    local e,s,_,refresh=setup();assert(e:arm(s));e:tick(s);s.now=21;refresh();assert(e:tick(s)==nil and not e.armed);assert(e:tick(s)==nil)
end)
check('pending feedback can clear its own transport fence but cannot send another call',function()
    local e,s,d,refresh=setup();shop(d);refresh();assert(e:arm(s));e:tick(s);s.transportBlocked=true;s.mutationFence=true
    d.current_shops={};refresh();assert(e:tick(s)==nil and e.confirmations==1 and not e.pending)
    assert(e:tick(s)==nil and not e.armed)
end)
check('stale pending readback never confirms',function()
    local e,s,d,refresh=setup();shop(d);refresh();assert(e:arm(s));e:tick(s);d.current_shops={};refresh();s.now=6
    assert(e:tick(s)==nil and not e.armed and e.confirmations==0)
end)
check('shop zero cap skips and requires exact phase removal',function()
    local e,s,d,refresh=setup();shop(d,20);refresh();assert(e:arm(s));assert(e:tick(s).name=='dungeon_continue_shop')
    d._resources.money=99;refresh();assert(e:tick(s)==nil and e.pending)
    d._resources.money=100;d.current_shops={};refresh();e:tick(s);assert(e.confirmations==1)
end)
check('unknown price skips purchase even with budget',function()
    local e,s,d,refresh=setup({dungeonShopCap=100});shop(d);refresh();assert(e:arm(s));assert(e:tick(s).name=='dungeon_continue_shop')
end)
check('shop purchase tracks confirmed exact spend and inventory',function()
    local e,s,d,refresh=setup({dungeonShopCap=25});shop(d,20);refresh();assert(e:arm(s));local a=e:tick(s)
    assert(a.name=='dungeon_buy_shop' and a.args[1]==1 and a.expected.price==20)
    s.rpcResult=false;e:tick(s);assert(e.confirmations==0 and e.spent==0)
    d._resources.money=80;refresh();e:tick(s);assert(e.pending)
    d._items={{id='tome'}};d.current_shops[1].data={};refresh();e:tick(s);assert(e.confirmations==1 and e.spent==20)
    shop(d,20);refresh();assert(e:tick(s).name=='dungeon_continue_shop')
end)
check('shop mismatched debit is never success',function()
    local e,s,d,refresh=setup({dungeonShopCap=30});shop(d,20);refresh();assert(e:arm(s));e:tick(s)
    d._resources.money=79;d._items={{id='tome'}};d.current_shops[1].data={};refresh();e:tick(s);assert(e.confirmations==0 and e.pending)
end)
check('shrine is skipped without acceptance endpoint',function()
    local e,s,d,refresh=setup();d.current_shops={{_t=7,data={{_t='Item',id='_curse_speed'}}}};refresh();assert(e:arm(s));assert(e:tick(s).name=='dungeon_continue_shop')
end)
check('end chest consent blocks finishing and does not spend keys',function()
    local e,s,d,refresh=setup();d._finished=true;d.current_shops={{_t=6,data={}}};refresh();assert(e:arm(s));assert(e:tick(s)==nil and not e.armed and e.reason:find('chest'))
end)
check('rare then normal chest confirmations require exact decrement',function()
    local e,s,d,refresh=setup({dungeonOpenChests=true});d._finished=true;d.current_shops={{_t=6,data={}}};refresh();assert(e:arm(s));local a=e:tick(s)
    assert(a.name=='dungeon_open_chest' and a.args[1]==true)
    d._resources.treasure=1;refresh();e:tick(s);assert(e.confirmations==0)
    d._resources.treasure=2;d._resources.treasure_gold=0;refresh();e:tick(s);assert(e.confirmations==1)
    a=e:tick(s);assert(a.name=='dungeon_open_chest' and #a.args==0)
    d._resources.treasure=1;refresh();e:tick(s);assert(e.confirmations==2)
end)
check('chest count dropping multiple is never confirmation',function()
    local e,s,d,refresh=setup({dungeonOpenChests=true});d._finished=true;d._resources.treasure_gold=0;d.current_shops={{_t=6,data={}}};refresh();assert(e:arm(s));e:tick(s)
    d._resources.treasure=0;refresh();e:tick(s);assert(e.confirmations==0 and e.pending)
end)
check('chest permission revoked while pending forbids next chest',function()
    local e,s,d,refresh,_,_,cfg=setup({dungeonOpenChests=true});d._finished=true;d.current_shops={{_t=6,data={}}};refresh();assert(e:arm(s));e:tick(s)
    cfg.dungeonOpenChests=false;d._resources.treasure_gold=0;refresh();e:tick(s);assert(e.confirmations==1);assert(e:tick(s)==nil and not e.armed)
end)
check('chest finish only after no unopened chests and typed finish state',function()
    local e,s,d,refresh=setup({dungeonOpenChests=true});d._finished=true;d._resources.treasure=0;d._resources.treasure_gold=0;d.current_shops={{_t=6,data={}}};refresh()
    assert(e:arm(s));assert(e:tick(s).name=='dungeon_continue_shop');d._started=false;d.current_shops={};refresh();e:tick(s);assert(e.confirmations==1)
    e:tick(s);assert(not e.armed and e.state=='COMPLETE')
end)
check('timeout eight seconds and explicit rejection never count success',function()
    local e,s,d,refresh=setup();shop(d);refresh();assert(e:arm(s));e:tick(s);s.now=9;refresh();e:tick(s);assert(not e.armed and e.confirmations==0)
    local e2,s2=setup();assert(e2:arm(s2));e2:tick(s2);e2:reject('false RPC');assert(not e2.armed and e2.confirmations==0)
end)
check('only exact permanent Rukia acquisition stops not claim',function()
    local e,s=setup();s.owned={{id='rukia_2',uuid='u',statScope='match'}};assert(e:arm(s));assert(e:tick(s).name=='dungeon_enter_room')
    local e2,s2=setup();s2.owned={{id='rukia_2',uuid='u',statScope='collection'}};s2.ownedAt=0;assert(not e2:arm(s2) and e2.state=='GOAL_MET')
    local e3,s3=setup();s3.owned={{id='rukia',uuid='u',statScope='collection'}};s3.ownedAt=0;assert(e3:arm(s3))
end)
check('session time limit and counter regression stop',function()
    local e,s,d,refresh=setup();assert(e:arm(s));s.now=301;refresh();assert(e:tick(s)==nil and not e.armed)
    local e2,s2,d2,refresh2=setup();assert(e2:arm(s2));d2._resources.treasure=1;refresh2();assert(e2:tick(s2)==nil and not e2.armed)
end)
check('foreign run cannot confirm shop or chest feedback',function()
    local e,s,d,refresh=setup({dungeonShopCap=30});shop(d,20);refresh();assert(e:arm(s));e:tick(s)
    d._resources.money=80;d._items={{id='tome'}};d.current_shops[1].data={};d.next['1']._d=9;refresh();e:tick(s)
    assert(e.pending and e.confirmations==0)
    local e2,s2,d2,refresh2=setup({dungeonOpenChests=true});d2._finished=true;d2.current_shops={{_t=6,data={}}};refresh2();assert(e2:arm(s2));e2:tick(s2)
    d2._resources.treasure_gold=0;d2.next['1']._d=9;refresh2();e2:tick(s2);assert(e2.pending and e2.confirmations==0)
end)
check('Acquire stops for permanent Rukia despite stale selected uuid',function()
    local e,s=setup({selectedUuid='old'});s.owned={{id='rukia_2',uuid='new',statScope='collection'}};s.ownedAt=0
    assert(not e:arm(s) and e.state=='GOAL_MET')
end)
check('preset changed to unknown is blocked safely',function()
    local e,s,_,_,_,_,cfg=setup();assert(e:arm(s));cfg.dungeonPreset='unknown';assert(e:tick(s)==nil and not e.armed)
end)
check('bounded malformed and cyclic schemas fail closed',function()
    local service,core,data=fixture();data.current_shops={{_t=7,data={}}};data.current_shops[1].data[1]=data.current_shops[1]
    assert(not D.snapshot(service,core).valid)
    data.current_shops={};data.next['1']._t['1']='yes';assert(not D.snapshot(service,core).valid)
end)
check('chest permission is for end only and intermediate chests stay stored',function()
    local e,s,d,refresh=setup({dungeonOpenChests=true});d.current_shops={{_t=6,data={}}};refresh();assert(e:arm(s))
    local a=e:tick(s);assert(a.name=='dungeon_continue_shop');assert(d._resources.treasure==2 and d._resources.treasure_gold==1)
end)
check('persistent shop offer confirms exact debit and inventory once',function()
    local e,s,d,refresh=setup({dungeonShopCap=100});shop(d,20);refresh();assert(e:arm(s));assert(e:tick(s).name=='dungeon_buy_shop')
    d._resources.money=80;d._items={{id='tome'}};refresh();e:tick(s);assert(e.confirmations==1 and e.spent==20)
    assert(e:tick(s).name=='dungeon_continue_shop')
end)
check('stale Victory after room transition cannot select a second room',function()
    local e,s,_,_,setLevel=setup();assert(e:arm(s));e:tick(s)
    s.inMatch=true;s.resultVisible=true;s.outcome='Victory';setLevel({_dungeon={depth=1,choice_str='1',lives=3}})
    e:tick(s);assert(e.confirmations==1);assert(e:tick(s)==nil and not e.pending)
    s.resultVisible=false;assert(e:tick(s)==nil and not e.pending)
end)
check('intermediate continue never confirms missing stored chests',function()
    local e,s,d,refresh=setup({dungeonOpenChests=true});d.current_shops={{_t=6,data={}}};refresh();assert(e:arm(s));e:tick(s)
    d.current_shops={};d._resources.treasure=1;refresh();e:tick(s);assert(e.pending and e.confirmations==0)
end)
check('last nonchest phase never discards unopened chests',function()
    local e,s,d,refresh=setup({dungeonOpenChests=true});d._finished=true;shop(d);refresh();assert(e:arm(s))
    assert(e:tick(s)==nil and not e.armed and e.reason:find('Unopened'))
end)
check('duplicate shop identities are skipped',function()
    local e,s,d,refresh=setup({dungeonShopCap=100});shop(d,20);d.current_shops[1].data[2]={id='tome',currentCost=10};refresh()
    assert(e:arm(s));assert(e:tick(s).name=='dungeon_continue_shop')
end)
local function activeRoom(flags,options)
    local e,s,d,refresh,setLevel=setup(options)
    d.next={['1']={_d=1,_t=flags}};d.selected_next={choice_str='1',lives=3};s.inMatch=true
    setLevel({_dungeon={depth=1,choice_str='1',lives=3,finished=false}});assert(e:arm(s))
    assert(e:tick(s)==nil);s.resultVisible=true;s.outcome='Victory'
    return e,s,d,refresh,setLevel
end
check('Victory with old selection waits rather than reentering current room',function()
    local e,s,d,refresh=activeRoom({['2']=true})
    assert(e:tick(s)==nil and e.armed and not e.pending)
    s.now=2;d.next['2']={_d=2,_t={['2']=true}};refresh()
    local a=e:tick(s);assert(a.name=='dungeon_enter_room' and a.expected.depth==2 and a.args[1]=='2')
end)
check('known postVictory shop must arrive even when forward offers replicate first',function()
    local e,s,d,refresh=activeRoom({['1']=true});assert(e:tick(s)==nil and e.armed)
    s.now=1;d.next={['1']={_d=2,_t={['2']=true}}};refresh();assert(e:tick(s)==nil and not e.pending)
    s.now=2;shop(d);refresh();assert(e:tick(s).name=='dungeon_continue_shop')
    d.current_shops={};refresh();e:tick(s);assert(e.confirmations==1)
    local a=e:tick(s);assert(a.name=='dungeon_enter_room' and a.expected.depth==2)
end)
check('delayed expected shrine and chest phases are resolved before advancement',function()
    for _,spec in {{flag='7',kind=7},{flag='6',kind=6}} do
        local e,s,d,refresh=activeRoom({[spec.flag]=true});assert(e:tick(s)==nil and e.armed)
        d.next={['1']={_d=2,_t={['2']=true}}};s.now=1;refresh();assert(e:tick(s)==nil)
        d.current_shops={{_t=spec.kind,data={}}};s.now=2;refresh();assert(e:tick(s).name=='dungeon_continue_shop')
        d.current_shops={};refresh();e:tick(s);assert(e:tick(s).expected.depth==2)
    end
end)
check('postVictory stale offers time out with zero mutations',function()
    local e,s,_,refresh=activeRoom({['2']=true});assert(e:tick(s)==nil)
    s.now=20;refresh();assert(e:tick(s)==nil and e.armed and not e.pending)
    s.now=21;refresh();assert(e:tick(s)==nil and not e.armed and e.confirmations==0 and not e.unresolved)
    assert(e.reason:find('timeout') and e:tick(s)==nil)
end)
check('known expected phase times out even if forward offers arrive',function()
    local e,s,d,refresh=activeRoom({['1']=true});assert(e:tick(s)==nil)
    d.next={['1']={_d=2,_t={['2']=true}}};s.now=21;refresh();assert(e:tick(s)==nil and not e.armed and not e.pending)
end)
check('normal verified forward offers advance without a phase expectation',function()
    local e,s,d,refresh=activeRoom({['2']=true});d.next={['1']={_d=2,_t={['1']=true}}};refresh()
    local a=e:tick(s);assert(a.name=='dungeon_enter_room' and a.expected.depth==2)
end)
check('all expected phases must resolve before offers permit advancement',function()
    local e,s,d,refresh=activeRoom({['1']=true,['7']=true});shop(d);refresh();assert(e:tick(s).name=='dungeon_continue_shop')
    d.current_shops={};d.next={['1']={_d=2,_t={['2']=true}}};refresh();e:tick(s)
    assert(e:tick(s)==nil and e.armed and not e.pending)
    d.current_shops={{_t=7,data={}}};s.now=2;refresh();assert(e:tick(s).name=='dungeon_continue_shop')
    d.current_shops={};refresh();e:tick(s);assert(e:tick(s).expected.depth==2)
end)
check('final boss waits for delayed terminal chest phase instead of stopping on lag',function()
    local e,s,d,refresh,setLevel=activeRoom({['5']=true},{dungeonOpenChests=true})
    d.next={['1']={_d=20,_t={['5']=true}}};s.resultVisible=false;setLevel({_dungeon={depth=20,choice_str='1',lives=3,finished=false}})
    e:tick(s);s.resultVisible=true;assert(e:tick(s)==nil and e.armed and not e.pending)
    d._finished=true;d.current_shops={{_t=6,data={}}};s.now=2;refresh();assert(e:tick(s).name=='dungeon_open_chest')
end)
check('shrine whitelist requires every typed current item and exact acquisition receipt',function()
 local e,s,d,refresh,_,core=setup({dungeonShrines=true,dungeonShrineItems='tome'})
 core.ITEMS.tome.name='Magic Tome';core.ITEMS.tome.description='Observed magic item'
 d.current_shops={{_t=7,data={{_t='Item',id='tome'}}}};refresh();assert(e:arm(s))
 local a=e:tick(s);assert(a.name=='dungeon_shrine_accept')
 d._resources.money=101;refresh();e:tick(s);assert(e.pending)
 d._resources.money=100;d._items={{id='tome'}};refresh();e:tick(s);assert(e.confirmations==1)
 assert(e:tick(s).name=='dungeon_continue_shop')
end)
check('unknown shrine records always skip instead of accepting',function()
 local e,s,d,refresh=setup({dungeonShrines=true,dungeonShrineItems='tome'})
 d.current_shops={{_t=7,data={{_t='Unknown',id='tome'}}}};refresh();assert(e:arm(s));assert(e:tick(s).name=='dungeon_continue_shop')
end)
check('custom shop priority selects exact observed item',function()
 local e,s,d,refresh,_,core=setup({dungeonShopCap=100,dungeonBuyOrder='second,tome'})
 core.ITEMS.second={cost=30,name='Second'};d.current_shops={{_t=1,data={{id='tome',currentCost=20},{id='second',currentCost=30}}}}
 refresh();assert(e:arm(s));local a=e:tick(s);assert(a.name=='dungeon_buy_shop' and a.args[1]==2)
end)
print('All '..n..' dungeon tests passed')
