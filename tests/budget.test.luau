local K=require('../src/contracts');local make=require('../src/budget');local n=0
local function test(name,f) local ok,err=pcall(f);assert(ok,name..': '..tostring(err));n+=1 end
local ctx={accountId=1,universeId=2,jobId='j',roundId='r',stageId='s',mode='Dungeon',epoch=0}
local function setup(cap)
 local saved;local fail=false;local b=make(K,{write=function(x) if fail then return false end;saved=K.copy(x);return true end},{accountId=1,universeId=2},function()return 100 end)
 local v={now=100,context=ctx,account={balances={key=100}}}
 local p=b.review({id='budget',caps={key=cap or 100},allowedOps={start=true},expires=200},v)
 local g=b.grant(p,true);return b,g,function()return saved end,function() fail=true end
end
local function intent(g,id,cost) return {id=id or 'one',capabilityId='start',kind='start',context=ctx,cost={key=cost or 30},expected={kind='start'},deadline=150,permissionId=g and g.id} end
test('zero cap denies and 30 reservation leaves 70',function()
 local b,g=setup(0);assert(not b.reserve(intent(g)))
 b,g=setup();assert(b.reserve(intent(g)));assert(b.remaining('key')==70);assert(not b.reserve(intent(g)))
end)
test('uncertainty survives checkpoint restore new round and new grant',function()
 local b,g,saved=setup();b.reserve(intent(g));b.sent('one');b.settle({intentId='one',status='uncertain'})
 local c=make(K,{write=function()return true end},{accountId=1,universeId=2},function()return 100 end)
 assert(c.restore(saved(),{accountId=1,universeId=2}));assert(c.remaining('key')==70)
 local p=c.review({id='new',caps={key=100},allowedOps={start=true},expires=200},{context=ctx});assert(not c.grant(p,true))
 assert(not c.reserve(intent(g,'two')))
end)
test('unsent rejection releases but sent rejection remains uncertain without proof',function()
 local b,g=setup();b.reserve(intent(g));assert(b.cancel('one'));assert(b.remaining('key')==100)
 b.reserve(intent(g,'two'));b.sent('two');assert(not b.cancel('two'));assert(b.remaining('key')==70)
end)
test('confirmation requires operation proof exact debit and cannot settle twice',function()
 local b,g=setup();b.reserve(intent(g));b.sent('one')
 assert(not b.settle({intentId='one',status='confirmed',debits={key=30}}));assert(b.remaining('key')==70)
 assert(b.settle({intentId='one',status='confirmed',proof=true,debits={key=30}}));assert(b.remaining('key')==70)
 assert(not b.settle({intentId='one',status='confirmed',proof=true,debits={key=30}}))
end)
test('durable write failure prevents reservation and cross-account restore',function()
 local b,g,saved,fail=setup();fail();assert(not b.reserve(intent(g)));assert(b.remaining('key')==100)
 assert(not b.restore(saved(),{accountId=9,universeId=2}))
end)
test('new round invalidates free reservations only',function()
 local b,g=setup();local a=intent(g,'free');a.cost={};b.reserve(a);b.sent('free');b.reserve(intent(g));b.sent('one')
 local nextCtx=K.copy(ctx);nextCtx.roundId='new';assert(b.invalidateRound(nextCtx));assert(not b.checkpoint().reservations.free and b.checkpoint().reservations.one)
end)
test('missing disk permits volatile free actions but never grants paid spending',function()
 local b=make(K,{write=function()return false end},{accountId=1,universeId=2},function()return 100 end)
 local a=intent(nil,'free');a.cost={};assert(b.reserve(a));assert(b.sent('free'))
 assert(b.settle({intentId='free',status='confirmed',proof=true,debits={}}));assert(b.volatile)
 local p=b.review({id='paid',caps={key=100},allowedOps={start=true},expires=200},{context=ctx});assert(not b.grant(p,true))
end)
print('All '..n..' budget tests passed')
