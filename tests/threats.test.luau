local C=require('../src/core');local T=require('../src/threats')(C)
local n=0;local function test(name,f)local ok,e=pcall(f);assert(ok,name..': '..tostring(e));n+=1 end
test('known enemies aggregate without guessing missing mechanics',function()
 local s=T.summarize({now=1,enemies={{id='boss',pos={2,0,0},health=100,boss=true,air=true},{id='x',pos={5,0,0},health=0}},enemiesComplete=true})
 assert(s.complete and s.alive==1 and s.bossAlive and s.air==1 and s.shields==nil)
end)
test('range requires complete observed candidates and actual reach',function()
 local s=T.summarize({enemies={{pos={10,0,0},health=2}},enemiesComplete=true})
 assert(T.near(s,{0,0,0},11)==true and T.near(s,{0,0,0},9)==false)
 s.complete=false;assert(T.near(s,{0,0,0},11)==nil)
end)
test('truncation malformed positions and unknown health are explicit',function()
 local s=T.summarize({enemies={{pos={0,0,0}}},enemiesComplete=true});assert(not s.complete and T.near(s,{0,0,0},10)==nil)
 s=T.summarize({enemies={},enemiesComplete=false});assert(not s.complete and s.bossAlive==nil)
end)
print('All '..n..' threats tests passed')
