local C=require('../src/core');local S=require('../src/settings')(C)
local x=S.validate({schema=1,settings={autoFollow=true,routeConfirmed=true,dungeonShrines=true,dungeonOpenChests=true,selectedUuid='private',maxRuns=4}})
assert(x.valid and x.settings.maxRuns==4 and not x.settings.autoFollow and not x.settings.dungeonShrines and not x.settings.routeConfirmed and x.settings.selectedUuid=='')
assert(not S.validate({schema=99,settings={}}).valid)
assert(not S.validate({schema=1,settings={},webhook='secret'}).valid)
assert(not S.validate({schema=1,settings={}},65537).valid)
local legacy=S.migrate({cfg={maxRuns=3}});assert(legacy.maxRuns==3 and not legacy.autoFollow)
assert(not S.name('../escape') and S.name('my_profile'))
print('All 6 settings cases passed')
