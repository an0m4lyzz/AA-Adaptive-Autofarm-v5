local C=require('../src/core');local make=require('../src/macro');local n=0
local function test(name,f)local ok,e=pcall(f);assert(ok,name..': '..tostring(e));n+=1 end
local function snap()return {now=0,run='r',roundToken='t',stage='s',placeId=9,mode='Story',stageVerified=true,modeVerified=true,rosterComplete=true,unitsComplete=true,started=true,wave=1,cash=1000,roster={{slot=1,id='a',uuid='u',cost=100,spawnCap=1}},units={}}end
local function data()return {schema=1,name='run',stage='s',placeId=9,mode='Story',steps={{kind='place',wave=1,target={slot=1,id='a',actor=1},pos={1,0,1},timeout=10},{kind='upgrade',wave=1,target={slot=1,id='a',actor=1},timeout=10}}}end
local function tower()return {key='model',uuid='u',id='a',pos={1,0,1},level=0,nextCost=50}end
test('validate rejects code unknown actions invalid positions size and secrets',function()
 local m=make(C,{},C.logger());assert(m:validate(data()).valid)
 for _,bad in ipairs({'request','loadstring','http'})do local d=data();d.steps[1].kind=bad;assert(not m:validate(d).valid)end
 local d=data();d.steps[1].pos[2]=0/0;assert(not m:validate(d).valid)
 d=data();d.steps[1].target.uuid='secret';assert(not m:validate(d).valid)
 assert(not m:validate(data(),262145).valid)
end)
test('playback verifies exact new actor and one-level upgrade',function()
 local m=make(C,{maxSeconds=60},C.logger());m.data=data();local s=snap();assert(m:arm(s));assert(m:tick(s).kind=='place')
 s.units={tower()};s.now=1;m:tick(s);assert(m.placements==1);s.now=2;assert(m:tick(s).kind=='upgrade')
 s.units[1].level=1;s.now=3;m:tick(s);assert(m.upgrades==1);m:tick(s);assert(m.state=='HOLDING')
end)
test('timeout stage change and missing actor never resend',function()
 local m=make(C,{maxSeconds=60},C.logger());m.data=data();local s=snap();m:arm(s);m:tick(s);s.now=11;assert(not m:tick(s) and not m.armed)
 m=make(C,{},C.logger());m.data=data();s=snap();assert(m:arm(s));s.stage='other';assert(not m:tick(s) and not m.armed)
end)
test('recording uses stable actor indices and never serializes UUID or model',function()
 local m=make(C,{},C.logger());local s=snap();m:startRecording(s,'demo');local p={kind='place',uuid='u',id='a',pos={1,0,1},before={}}
 s.units={tower()};assert(m:record(p,s));assert(m.data.steps[1].target.actor==1 and not m.data.steps[1].target.uuid)
 assert(m:record({kind='upgrade',key='model',uuid='u',id='a'},s));assert(#m.data.steps==2)
 assert(not m:record({kind='upgrade',key='not-recorded',uuid='u',id='a'},s))
end)
test('wave timing waits without spending and imported identity cannot replace a slot',function()
 local d=data();d.steps[1].wave=3;local m=make(C,{},C.logger());m.data=d;local s=snap();assert(m:arm(s));assert(not m:tick(s));s.wave=3;assert(m:tick(s))
 m=make(C,{},C.logger());m.data=data();s=snap();s.roster[1].id='other';assert(not m:arm(s))
end)
test('explicit manual capture records one observed change and rejects ambiguity',function()
 local m=make(C,{},C.logger());local b=snap();local a=snap();a.roundToken=b.roundToken;a.units={tower()}
 local p=m:captureManual(b,a,'place');assert(p and p.kind=='place' and p.before)
 a.units[2]=tower();a.units[2].key='other';assert(not m:captureManual(b,a,'place'))
end)
test('scheduled first and later macro waves do not consume precondition timeout',function()
 local m=make(C,{maxSeconds=300},C.logger());local d=data();d.steps[1].wave=3;d.steps[2].wave=8;m.data=d;local s=snap();assert(m:arm(s))
 s.now=40;s.wave=2;assert(not m:tick(s) and m.armed);s.now=50;s.wave=3;assert(m:tick(s).kind=='place')
 s.units={tower()};s.now=51;m:tick(s);s.now=100;s.wave=7;assert(not m:tick(s) and m.armed)
 s.now=110;s.wave=8;assert(m:tick(s).kind=='upgrade')
end)
test('same unit type replacement requires a new explicit macro arm',function()
 local m=make(C,{},C.logger());local d=data();d.steps[1].wave=3;m.data=d;local s=snap();assert(m:arm(s))
 s.roster[1].uuid='replacement';s.wave=3;assert(not m:tick(s) and not m.armed)
end)
test('authorized macro continuation keeps exact private roster binding',function()
 local m=make(C,{},C.logger());m.data=data();local s=snap();assert(m:arm(s));local binding=m:rosterCheckpoint()
 local nextM=make(C,{},C.logger());nextM.data=data();nextM.resumeBindings=binding;s.roster[1].uuid='changed';assert(not nextM:arm(s))
 assert(nextM:signature(data()) and not data().steps[1].target.uuid)
end)
print('All '..n..' macro tests passed')
