local C=require('../src/core')
local makeTrial=require('../src/trial')
local n=0
local function check(name,fn)
    local ok,err=pcall(fn);assert(ok,name..': '..tostring(err));n+=1;print('PASS '..name)
end
local function setup(upgrade)
    local cfg=C.sanitize({reserve=100})
    local t=makeTrial(C,cfg,C.logger())
    local s={now=1,run='r1',inMatch=true,started=true,stage='namek_level_1',stageVerified=true,
        mode='Story',modeVerified=true,placeId=9,cash=2000,rosterAt=1,unitsComplete=true,
        roster={{uuid='a',id='bulma',slot=4,cost=800}},units={},costScale=1}
    local p={stage=s.stage,mode=s.mode,placeId=s.placeId,source='user-recorded',costScale=1,
        entries={{uuid='a',id='bulma',slot=4,pos={1,2,3},cost=800}}}
    if upgrade then s.units={{key='tower',uuid='a',id='bulma',pos={1,2,3},level=0,nextCost=1500}} end
    return t,s,p,cfg
end
check('idle trial never emits an action',function()
    local t,s=setup();assert(t:tick(s)==nil and not t.pending and t.state=='IDLE')
end)
check('one placement quote does not require or grant Rukia route consent',function()
    local t,s,p,cfg=setup();local q=t:quote('place',s,p)
    assert(q and q.cost==800 and q.slot==4 and not cfg.routeConfirmed and not cfg.protocolConfirmed)
    assert(#C.readiness(s,p,cfg)>0)
end)
check('begin requires a displayed quote and emits only one place action',function()
    local t,s,p=setup();assert(not t:begin('place',s,p,nil))
    local q=t:quote('place',s,p);local action=t:begin('place',s,p,q)
    assert(action and action.kind=='place' and action.uuid=='a' and t.pending)
    assert(not t:begin('place',s,p,q) and t:tick(s)==nil)
end)
check('upgrade trial targets the exact recorded model and observed next price',function()
    local t,s,p=setup(true);local q=t:quote('upgrade',s,p)
    assert(q and q.cost==1500 and q.level==0)
    local a=t:begin('upgrade',s,p,q);assert(a and a.key=='tower' and a.kind=='upgrade')
end)
check('only one recorded tower is accepted for a single action test',function()
    local t,s,p=setup();p.entries[2]=table.clone(p.entries[1])
    assert(not t:quote('place',s,p))
end)
check('cash shortage and reserve block spending rather than queueing',function()
    local t,s,p=setup(true);s.cash=1500
    local q,why=t:quote('upgrade',s,p)
    assert(not q and why:find('1500',1,true) and why:find('reserve',1,true) and not t.pending)
end)
check('paid or unverified modes cannot use the supervised Story test',function()
    for _,mode in ipairs({'Dungeon','Portal','Raid','Event','Challenge'}) do
        local t,s,p=setup();s.mode=mode;p.mode=mode;assert(not t:quote('place',s,p))
    end
    local t,s,p=setup();s.modeVerified=false;assert(not t:quote('place',s,p))
end)
check('incomplete or stale observations block the trial',function()
    local t,s,p=setup();s.unitsComplete=false;assert(not t:quote('place',s,p))
    s.unitsComplete=true;s.rosterAt=-30;assert(not t:quote('place',s,p))
end)
check('finished matches and outstanding native requests block the trial',function()
    local t,s,p=setup();s.resultVisible=true;assert(not t:quote('place',s,p))
    s.resultVisible=false;s.transportBlocked=true;assert(not t:quote('place',s,p))
end)
check('an existing copy must be manually removed before a placement test',function()
    local t,s,p=setup(true);assert(not t:quote('place',s,p))
    s.units={};assert(t:quote('place',s,p))
end)
check('another tower at the recorded position blocks placement',function()
    local t,s,p=setup();s.units={{key='other',uuid='b',id='feitan_evolved',pos={1,2,3}}}
    assert(not t:quote('place',s,p))
end)
check('changed price or upgrade level invalidates the displayed quote',function()
    local t,s,p=setup(true);local q=t:quote('upgrade',s,p)
    s.units[1].nextCost=1600;assert(not t:begin('upgrade',s,p,q))
    s.units[1].nextCost=1500;s.units[1].level=1;assert(not t:begin('upgrade',s,p,q))
end)
check('stale quote cannot spend even with a fresh roster',function()
    local t,s,p=setup();local q=t:quote('place',s,p)
    s.now=7;s.rosterAt=7;assert(not t:begin('place',s,p,q))
end)
check('exact new tower confirms one placement and never starts another action',function()
    local t,s,p,cfg=setup();assert(t:begin('place',s,p,t:quote('place',s,p)))
    s.now=2;s.units={{key='new',uuid='a',id='bulma',pos={1,2,3}}}
    assert(t:tick(s)==nil and t.placements==1 and not t.pending and t.state=='OBSERVED')
    assert(t:tick(s)==nil and t.placements==1 and not cfg.protocolConfirmed)
end)
check('existing model and unrelated new tower never confirm the placement',function()
    local t,s,p=setup();s.units={{key='old',uuid='b',id='other',pos={20,2,20}}}
    assert(t:begin('place',s,p,t:quote('place',s,p)))
    s.units={{key='old',uuid='a',id='bulma',pos={1,2,3}},{key='new',uuid='b',id='other',pos={1,2,3}}}
    s.now=2;t:tick(s);assert(t.pending and t.placements==0)
end)
check('exact one-level increase confirms only the requested upgrade',function()
    local t,s,p=setup(true);assert(t:begin('upgrade',s,p,t:quote('upgrade',s,p)))
    s.now=2;s.units[1].level=1;t:tick(s)
    assert(t.upgrades==1 and not t.pending and t.placements==0)
end)
check('unexpected multi-level increase is unconfirmed',function()
    local t,s,p=setup(true);assert(t:begin('upgrade',s,p,t:quote('upgrade',s,p)))
    s.now=2;s.units[1].level=2;t:tick(s)
    assert(t.upgrades==0 and not t.pending and t.state=='UNCONFIRMED')
end)
check('late exact tower cannot turn an expired test into success',function()
    local t,s,p=setup();assert(t:begin('place',s,p,t:quote('place',s,p)))
    s.now=10;s.units={{key='new',uuid='a',id='bulma',pos={1,2,3}}};t:tick(s)
    assert(not t.pending and t.placements==0 and t.state=='UNCONFIRMED')
end)
check('run changes stop the trial without confirming or retrying',function()
    local t,s,p=setup();assert(t:begin('place',s,p,t:quote('place',s,p)))
    s.run='r2';t:tick(s);assert(not t.pending and t.placements==0)
end)
check('rejection does not allow another test of the same kind in that run',function()
    local t,s,p=setup();assert(t:begin('place',s,p,t:quote('place',s,p)))
    t:cancel('Remote rejected');assert(not t:quote('place',s,p))
    s.run='r2';assert(t:quote('place',s,p))
end)
check('pending coordinates are copied rather than following later profile edits',function()
    local t,s,p=setup();assert(t:begin('place',s,p,t:quote('place',s,p)))
    p.entries[1].pos[1]=99
    s.now=2;s.units={{key='new',uuid='a',id='bulma',pos={1,2,3}}};t:tick(s)
    assert(t.placements==1)
end)
check('multiple exact new towers make placement readback ambiguous',function()
    local t,s,p=setup();assert(t:begin('place',s,p,t:quote('place',s,p)))
    s.now=2;s.units={{key='new1',uuid='a',id='bulma',pos={1,2,3}},
        {key='new2',uuid='a',id='bulma',pos={2,2,3}}}
    t:tick(s);assert(t.state=='UNCONFIRMED' and not t.pending and t.placements==0)
end)
check('an unconfirmed test blocks both action kinds in the same run',function()
    local t,s,p=setup(true);assert(t:begin('upgrade',s,p,t:quote('upgrade',s,p)))
    t:cancel('Unknown response');s.units={};assert(not t:quote('place',s,p))
end)
check('missing recorded identity cannot form a quote',function()
    local t,s,p=setup();p.entries[1].uuid=nil;s.roster[1].uuid=nil
    assert(not t:quote('place',s,p))
end)
check('loss of verified Story mode makes pending readback unconfirmed',function()
    local t,s,p=setup(true);assert(t:begin('upgrade',s,p,t:quote('upgrade',s,p)))
    s.now=2;s.modeVerified=false;s.units[1].level=1;t:tick(s)
    assert(t.state=='UNCONFIRMED' and t.upgrades==0 and not t.pending)
end)
check('selected test slot cannot silently follow a moved equipped copy',function()
    local t,s,p=setup();p.testSlot=4;s.roster[1].slot=5
    assert(not t:quote('place',s,p))
end)
check('a saved target profile can place an unsellable unit in a fresh matching stage',function()
    local t,s,p,cfg=setup(true);p.testSlot=4
    assert(not t:quote('place',s,p))
    local restored=makeTrial(C,C.sanitize(cfg),C.logger())
    local fresh=table.clone(s);fresh.run='fresh-match';fresh.units={};fresh.cash=900
    local quote=restored:quote('place',fresh,p)
    assert(quote and quote.cost==800 and C.distance(quote.pos,p.entries[1].pos)==0)
    local action=restored:begin('place',fresh,p,quote)
    assert(action and action.kind=='place' and action.uuid=='a')
    fresh.stage='different-stage';assert(not makeTrial(C,cfg,C.logger()):quote('place',fresh,p))
end)
print('All '..n..' trial tests passed')
