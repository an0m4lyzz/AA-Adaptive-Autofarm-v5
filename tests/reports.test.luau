local C=require('../src/core');local make=require('../src/reports');local n=0
local function test(name,f)local ok,e=pcall(f);assert(ok,name..': '..tostring(e));n+=1 end
test('round outcomes deduplicate and contradictions remain unknown',function()
 local r=make(C);r:outcome('round','Victory');r:outcome('round','Victory');assert(r.wins==1)
 r:outcome('round','Defeat');assert(r.wins==0 and r.losses==0 and r.unknown==1)
end)
test('logs retention byte limit and secret redaction are bounded',function()
 local r=make(C);for i=1,1000 do r:record({kind='test',detail=string.rep('x',200)})end
 assert(#r.events==500 and r.dropped==500 and #r:render()<=65536)
 r:record({kind='private',detail='12345678-1234-1234-1234-123456789012 https://discord.com/api/webhooks/id/secret'})
 local s=r:render();assert(not s:find('12345678',1,true) and not s:find('/secret',1,true))
end)
test('notifications require explicit destination and timeout does not retry',function()
 local sent=0;local r=make(C,{start=function(_,_,callback)sent+=1 end})
 assert(not r:queueNotification({id='one',text='test'},{enabled=false,url='https://discord.com/api/webhooks/a/b'}))
 assert(r:queueNotification({id='one',text='test'},{enabled=true,url='https://discord.com/api/webhooks/a/b'}));r:tick(0);r:tick(9);r:tick(99);assert(sent==1 and r.notificationState:find('unknown'))
end)
test('429 retry is bounded while successful receipt removes one event',function()
 local count=0;local r=make(C,{start=function(_,_,cb)count+=1;cb(429)end})
 r:queueNotification({id='x',text='x'},{enabled=true,url='https://discord.com/api/webhooks/a/b'})
 r:tick(0);r:tick(31);r:tick(62);r:tick(93);assert(count==3 and #r.queue==0)
end)
test('feature catalog is complete and never silently says live passed',function()
 local F=require('../src/features');assert(#F==59)
 for _,f in ipairs(F)do assert(f.id and f.status~='live')end
end)
test('revoked outstanding webhook cannot remove a newly queued event',function()
 local callback;local r=make(C,{start=function(_,_,cb)callback=cb end})
 local consent={enabled=true,url='https://discord.com/api/webhooks/a/b'}
 r:queueNotification({id='old',text='old'},consent);r:tick(0);r:revokeNotifications()
 r:queueNotification({id='new',text='new'},consent);callback(204);assert(#r.queue==1 and r.queue[1].text=='new')
end)
test('retained outcome checkpoint restores dedup without claiming new wins',function()
 local a=make(C);a:outcome('r','Victory');local b=make(C);assert(b:restore(a:checkpoint()));assert(not b:outcome('r','Victory') and b.wins==1)
 assert(not b:restore({wins=-1,losses=0,unknown=0,order={},outcomes={}}));assert(#b:render(2000)<=2000)
end)
print('All '..n..' report tests passed')
